node_modules/
*/node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
build/
.pnpm-store/
.vite/
frontend/.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
*.tsbuildinfo
.eslintcache
.turbo/

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Temporary mockups & test assets generated during design iterations
frontend/public/nautilus-hero-*.png
frontend/public/nautilus-hero-*.jpg
frontend/public/nautilus-card-*.jpg
frontend/public/*-mockup.*

